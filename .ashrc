alias ls='ls -FC'
alias t='tmux attach'
alias pi1='ssh pi1.local'
alias pi2='ssh pi2.local'
alias pi3='ssh pi3.local'
alias mosh1='mosh pi1.local'
alias mosh2='mosh pi2.local'
alias mosh3='mosh pi3.local'
alias kindle='ssh root@10.0.0.15'
alias bato='ssh root@bato.local'
#alias vncs='vncserver-virtual -Authentication None :1 -geometry 768x1024'
alias vncs='vncserver-virtual :1 -geometry 1280x800'
alias novncs='vncserver-virtual -kill :1'
alias fixfont='setfont /usr/share/consolefonts/Uni2-TerminusBold32x16.psf.gz'
alias fixfont2='setfont /usr/share/consolefonts/Uni2-Terminus32x16.psf.gz'
# Arch fonts
alias fixfont3='setfont ter-g24n.psf.gz'
# Alpine fonts
alias fixfont4='setfont /usr/share/consolefonts/ter-132b.psf.gz'
alias wttr='curl wttr.in?T1nF'
alias tmuxsize='tmux display -p "#{pane_width}x#{pane_height}" '
alias dfx='df -h -x tmpfs'
alias dusht='du -sh -t 1G *'
alias brightness='kindle -- /mnt/us/extensions/kterm/brightness'
alias b0='brightness 0'
alias b1='brightness 100'
alias esdiff='sudo vimdiff /opt/retropie/configs/all/emulationstation/es_systems.cfg /etc/emulationstation/es_systems.cfg'
alias ed='ed -v -p:'
alias grp='grep -Iir'


alias zeptoforth='picocom -b 115200 /dev/cu.usb*'
alias picomite='picocom -b 115200 --omap delbs /dev/cu.usb*'
alias quintus='picocom -b 115200 --imap lfcrlf,crcrlf --omap delbs,crlf /dev/cu.usb*'
